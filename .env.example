# Supabase Configuration
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_SUPABASE_URL=https://your-supabase-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Configuration
PORT=8080
NODE_ENV=development

# Domain & API Routing Configuration (Change here to switch domains)
APP_DOMAIN=69club1.site
API_DOMAIN=api.69club1.site
FRONTEND_URL=https://69club1.site
API_URL=https://api.69club1.site

# Frontend Environment (Vite)
VITE_APP_DOMAIN=69club1.site
VITE_API_DOMAIN=api.69club1.site
VITE_API_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api

# Merchant UPI Payment Details (10 - 15 Rotational Accounts Pool)
MERCHANT_UPI_VPA=princeclub@upi
MERCHANT_NAME=Prince Club

# Optional Comma-separated UPI Pool:
# MERCHANT_UPI_POOL=upi1@bank,upi2@bank,upi3@bank

# Rotational UPI Pool Variables (Auto-rotated for deposit QR generation):
MERCHANT_UPI_VPA_1=princeclub1@upi
MERCHANT_UPI_NAME_1=Prince Club 1
MERCHANT_UPI_VPA_2=princeclub2@upi
MERCHANT_UPI_NAME_2=Prince Club 2
MERCHANT_UPI_VPA_3=princeclub3@upi
MERCHANT_UPI_NAME_3=Prince Club 3
MERCHANT_UPI_VPA_4=princeclub4@upi
MERCHANT_UPI_NAME_4=Prince Club 4
MERCHANT_UPI_VPA_5=princeclub5@upi
MERCHANT_UPI_NAME_5=Prince Club 5
MERCHANT_UPI_VPA_6=princeclub6@upi
MERCHANT_UPI_NAME_6=Prince Club 6
MERCHANT_UPI_VPA_7=princeclub7@upi
MERCHANT_UPI_NAME_7=Prince Club 7
MERCHANT_UPI_VPA_8=princeclub8@upi
MERCHANT_UPI_NAME_8=Prince Club 8
MERCHANT_UPI_VPA_9=princeclub9@upi
MERCHANT_UPI_NAME_9=Prince Club 9
MERCHANT_UPI_VPA_10=princeclub10@upi
MERCHANT_UPI_NAME_10=Prince Club 10
MERCHANT_UPI_VPA_11=princeclub11@upi
MERCHANT_UPI_NAME_11=Prince Club 11
MERCHANT_UPI_VPA_12=princeclub12@upi
MERCHANT_UPI_NAME_12=Prince Club 12
MERCHANT_UPI_VPA_13=princeclub13@upi
MERCHANT_UPI_NAME_13=Prince Club 13
MERCHANT_UPI_VPA_14=princeclub14@upi
MERCHANT_UPI_NAME_14=Prince Club 14
MERCHANT_UPI_VPA_15=princeclub15@upi
MERCHANT_UPI_NAME_15=Prince Club 15

# Set to true for automated sandbox/testing approval of submitted UTRs
AUTO_APPROVE_UTR=false

# Admin Security Configuration
# Admin authorization requires a bearer session and a live DB admin role.
# ADMIN_IDENTIFIER optionally restricts access to one username or email.
ADMIN_IDENTIFIER=your-admin-phone-or-email@example.com
