# Supabase Configuration
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_SUPABASE_URL=https://your-supabase-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Configuration
PORT=8080
NODE_ENV=development

# Domain & API Routing Configuration (Change here to switch domains)
APP_DOMAIN=69club1.site
API_DOMAIN=api.69club1.site
FRONTEND_URL=https://69club1.site
API_URL=https://api.69club1.site

# Frontend Environment (Vite)
VITE_APP_DOMAIN=69club1.site
VITE_API_DOMAIN=api.69club1.site
VITE_API_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api

# Merchant UPI Payment Details
MERCHANT_UPI_VPA=club69@upi
MERCHANT_NAME=69 Club

# Set to true for automated sandbox/testing approval of submitted UTRs
AUTO_APPROVE_UTR=false

# Admin Security Configuration
# Admin authorization requires a bearer session and a live DB admin role.
# ADMIN_IDENTIFIER optionally restricts access to one username or email.
ADMIN_IDENTIFIER=your-admin-phone-or-email@example.com
