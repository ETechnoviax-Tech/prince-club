# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
# Obtain from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Merchant UPI Payment Details
MERCHANT_UPI_VPA=princeclub@upi
MERCHANT_NAME=Prince Club

# Set to true for automated sandbox/testing approval of submitted UTRs
AUTO_APPROVE_UTR=false
